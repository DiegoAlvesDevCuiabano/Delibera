# ===== Delibera - Variáveis de Ambiente =====

# Perfil local com PostgreSQL
DB_USER=delibera
DB_PASS=delibera123
DB_PORT=5432
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Diretório dos anexos. Em Docker precisa apontar para um volume persistente,
# senão os atestados somem a cada redeploy.
DELIBERA_UPLOAD_DIR=uploads

# SMTP real no ambiente de desenvolvimento completo
EMAIL_ENABLED=true
MAIL_HEALTH_ENABLED=false
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USER=contato@appdelibera.com.br
# Obrigatório para envio real. Use uma senha de aplicativo e mantenha-a apenas no .env local.
MAIL_PASS=
MAIL_FROM=contato@appdelibera.com.br

# Produção (configure na plataforma, nunca neste arquivo versionado)
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:postgresql://host:5432/delibera
# DELIBERA_BASE_URL=https://app.seudominio.com.br
# DELIBERA_ROOT_EMAIL=admin@seudominio.com.br
# DELIBERA_ROOT_PASSWORD=SenhaForteCom12+Caracteres
# UPLOAD_DIR=/app/uploads
#
# OBRIGATÓRIO em produção — a aplicação não sobe sem. Assina os links de voucher
# enviados por email. Gere com: openssl rand -base64 48
# Trocar o valor invalida os links já enviados.
# TOKEN_SECRET=cole-aqui-um-valor-aleatorio-longo
